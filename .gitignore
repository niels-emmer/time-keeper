# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Dependencies
node_modules
.pi/npm/

# Build artifacts
dist
build

# TypeScript incremental build info (emitted by `tsc -b`)
*.tsbuildinfo

# Emitted copies of the Vite config. These shadow vite.config.ts: Vite resolves
# vite.config.js before vite.config.ts, so a stale JS copy must never exist.
packages/frontend/vite.config.js
packages/frontend/vite.config.js.map
packages/frontend/vite.config.d.ts
packages/frontend/vite.config.d.ts.map

# Environment
.env
*.env.local

# SQLite data
*.db
*.db-journal
*.db-wal
*.db-shm
dev-data/

# OS
.DS_Store
