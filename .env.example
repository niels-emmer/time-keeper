# Copy to .env and fill in your values
# .env is gitignored — never commit it

# Shared secret between the frontend nginx and the backend.
# Prevents X-authentik-email header injection on the api.* subdomain by
# ensuring the backend only trusts Authentik identity headers when a matching
# X-Internal-Token header is present (set by frontend nginx, never by NPM).
#
# Generate with:  openssl rand -hex 32
INTERNAL_PROXY_SECRET=replace-with-openssl-rand-hex-32

# --- Phase A/B: accounts and sessions --------------------------------------
# Which auth path is authoritative: proxy | local | hybrid.
# `proxy` keeps the Authentik header path and is the current default. `local`
# uses the app's own login endpoint and server-side session cookie (Phase B);
# `hybrid` accepts either for a staged migration.
AUTH_MODE=proxy

# The account promoted to role=admin at boot. In production the backend
# refuses to start if this is missing or matches no existing user.
# On a migrated database this must be one of the pre-existing emails.
ADMIN_EMAIL=you@example.com

# Session secret (>= 32 characters). Production refuses to boot without it.
# Generate with:  openssl rand -base64 48
SESSION_SECRET=replace-with-openssl-rand-base64-48

# 32-byte key protecting TOTP secrets at rest, base64 or hex.
# Production refuses to boot without it.
# Generate with:  openssl rand -base64 32
MFA_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# See docs/memory/INDEX.md for the Authentik + NPM walkthrough and
# docs/operations/migration-phase-a.md before upgrading an existing database.
