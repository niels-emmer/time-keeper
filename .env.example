# Copy to .env and fill in your values.
# .env is gitignored — never commit it.
#
# This is the complete template for both auth modes. In production the backend
# refuses to boot when a required secret is missing or malformed, and names the
# variable in the error. See docs/operations/deployment.md and
# docs/integration/auth.md.

# --- Auth mode --------------------------------------------------------------
# local  (default) — the app's own accounts: password + optional TOTP, with
#                    server-side sessions and its own /login page.
# proxy            — Authentik forward auth via NPM; the app reads the trusted
#                    X-authentik-email header. Requires the NPM forward-auth
#                    host config and INTERNAL_PROXY_SECRET.
# hybrid           — accept both, for a staged migration. Then switch to local.
AUTH_MODE=local


# --- Required in production (AUTH_MODE=local) --------------------------------
# Session secret, at least 32 characters. Rotating it signs everyone out.
# Generate with:  openssl rand -base64 48
SESSION_SECRET=replace-with-openssl-rand-base64-48

# 32-byte key that encrypts TOTP secrets at rest, base64 or hex.
# Generate with:  openssl rand -base64 32   (or: openssl rand -hex 32)
#
# WARNING: changing this key makes every enrolled TOTP secret unreadable.
# Affected users must re-enrol MFA (an admin can reset their password; they
# then enrol again). Keep it stable and back it up with the database.
MFA_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# The account promoted to role=admin at boot.
# - Migrated database: must match one of the pre-existing emails, or the
#   backend refuses to boot.
# - Brand-new empty database: the backend creates this account and prints a
#   one-time 60-minute reset code to the logs. Open /reset?code=<code> to set
#   its password. No password is generated or logged.
ADMIN_EMAIL=you@example.com


# --- Required only when AUTH_MODE is proxy or hybrid -------------------------
# Shared secret between the frontend nginx and the backend. Prevents
# X-authentik-email header injection on the api.* subdomain by ensuring the
# backend only trusts Authentik identity headers when a matching
# X-Internal-Token header is present (set by frontend nginx, never by NPM).
#
# Generate with:  openssl rand -hex 32
INTERNAL_PROXY_SECRET=replace-with-openssl-rand-hex-32


# --- Build ----------------------------------------------------------------
# Optional explicit version override; normally set from the latest git tag by
# `APP_VERSION=$(git describe --tags --abbrev=0) docker compose up -d --build`.
# APP_VERSION=


# --- Rollback to Authentik (no code change) ----------------------------------
# 1. Set AUTH_MODE=proxy (and keep INTERNAL_PROXY_SECRET set).
# 2. Restore the NPM forward-auth Advanced config for the Time Keeper host.
# 3. docker compose up -d
# Local accounts and passwords stay in the database; you can switch back.
