{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    // Keep `tsc -b` bookkeeping out of the source tree.
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.sw.tsbuildinfo"
  },
  "include": ["src/sw.ts", "src/workers"]
}
